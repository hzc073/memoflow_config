  "release_notes": [
    {
      "version": "1.0.34",
      "date": "2026-06-22",
      "items": [
        {
          "category": "feature",
          "contents": {
            "zh-Hans": [
              "Android quick recording feature",
              "Pairing connection status page",
              "Added iOS compatibility"
            ]
          }
        },
        {
          "category": "improvement",
          "contents": {
            "zh-Hans": [
              "Optimized settings page controls, form experience, and support page donation flow",
              "Improved note search, tag recognition, Markdown import, and memo operation entry points"
            ]
          }
        },
        {
          "category": "fix",
          "contents": {
            "zh-Hans": [
              "Fixed local database path, avatar handling, and residual configuration after deleting AI settings service",
              "Fixed issues with settings window plugin registration, display of unavailable entries, and cleanup of old account status after reinstallation"
            ]
          }
        }
      ]
    },
    {
